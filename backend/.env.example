# API-Football key (https://dashboard.api-football.com). Free plan: 100 requests/day, seasons 2022-2024.
API_FOOTBALL_KEY=
# Stop calling the API after this many requests per UTC day (shared with any other client using the key).
DAILY_REQUEST_BUDGET=90
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:8080,https://laligaprediction.netlify.app
# Seasons used to build the snapshot / train the model.
TRAINING_SEASONS=2022,2023,2024
